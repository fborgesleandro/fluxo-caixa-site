# Neon PostgreSQL Connection URLs
# DATABASE_URL: Pooled connection string (host com -pooler, porta 6543) para Next.js / Serverless
DATABASE_URL="postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct connection string (porta 5432) para migrations Prisma
DIRECT_URL="postgresql://usuario:senha@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Chave secreta criptograficamente forte para autenticação JWT (gerada aleatoriamente)
JWT_SECRET="seu_jwt_secret_forte_e_aleatorio_aqui"

# Configuração da aplicação
NEXT_PUBLIC_APP_NAME="Fluxo de Caixa"
